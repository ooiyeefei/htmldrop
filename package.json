{
  "name": "@yeefeiooi/htmldrop",
  "version": "1.17.0",
  "description": "Publish HTML files and get shareable links via Surge.sh",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ooiyeefei/htmldrop.git"
  },
  "homepage": "https://github.com/ooiyeefei/htmldrop#readme",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "htmldrop": "bin/htmldrop.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "bin/",
    "src/",
    "templates/"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs && node test-fixtures/crypto-roundtrip.test.mjs && node test-fixtures/access-token.test.mjs",
    "diagrams": "mmdc -i docs/diagrams/collab-flow.mmd -o docs/assets/collab-flow.svg -c docs/diagrams/theme.json -p docs/diagrams/puppeteer.json -b transparent && mmdc -i docs/diagrams/collab-flow.mmd -o docs/assets/collab-flow.png -c docs/diagrams/theme.json -p docs/diagrams/puppeteer.json -b white -s 2",
    "build:editor": "node scripts/build-editor.mjs",
    "pretest": "npm run build:editor",
    "prepack": "npm run build:editor"
  },
  "keywords": [
    "html",
    "share",
    "publish",
    "surge",
    "cli",
    "static",
    "hosting"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "commander": "^12.1.0",
    "crypto-js": "^4.2.0",
    "open": "^10.1.0",
    "parse5": "7.3.0",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "surge": ">=0.23.0"
  },
  "peerDependenciesMeta": {
    "surge": {
      "optional": true
    }
  },
  "devDependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@excalidraw/mermaid-to-excalidraw": "2.2.2",
    "@mermaid-js/mermaid-cli": "11.4.2",
    "esbuild": "0.25.12",
    "playwright": "^1.61.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "overrides": {
    "@excalidraw/excalidraw": {
      "nanoid": "3.3.20"
    },
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "5.1.16"
    },
    "lodash-es": "4.18.1"
  }
}
